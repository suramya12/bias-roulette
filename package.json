{
  "name": "bias-roulette",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "K-pop roulette game with a built-in YouTube player. Static site, no dependencies.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "lan": "node scripts/serve.mjs --lan",
    "test": "node --test tests/ anime/test/",
    "anime:resolve": "node anime/scripts/resolve.mjs && echo Run npm run landing to refresh data/landing.json",
    "landing": "node scripts/landing-manifest.mjs",
    "anime:health": "node anime/scripts/health.mjs",
    "resolve": "node scripts/resolve.mjs",
    "video-ids": "node scripts/video-ids.mjs",
    "art:variants": "node scripts/art-variants.mjs",
    "anime:runtime": "node anime/scripts/runtime.mjs",
    "charts": "node scripts/charts.mjs",
    "portraits": "node scripts/portraits.mjs",
    "sets": "node scripts/sets.mjs",
    "data:kpop": "node scripts/kpop-engine-data.mjs",
    "data:anime-engine": "node anime/scripts/engine-data.mjs"
  }
}
